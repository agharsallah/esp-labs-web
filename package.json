{
  "name": "esp-labs-web",
  "version": "0.1.0",
  "private": true,
  "description": "The ESP32-S3 bench guide as a React app: pinout, lessons, simulators and the bench log.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "i18n:extract": "vitest run src/content/catalogues.test.ts --update",
    "chip:refs": "node tools/chip/check-refs.ts",
    "deploy:preview": "vercel pull --yes --environment=preview && vercel build && vercel deploy --prebuilt",
    "deploy:prod": "vercel pull --yes --environment=production && vercel build --prod && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "i18next": "26.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/eslint-plugin-query": "5.104.3",
    "@tanstack/react-query-devtools": "5.104.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
