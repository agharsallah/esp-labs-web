# Where the bench data (status + log JSON) is fetched from. Relative to the page by default,
# so the built guide works from any static server and as a static artifact. Point it at any host serving the
# same JSON shape (e.g. the Hardware Diary API later).
VITE_BENCH_DATA_URL=./data/
# debug | info | warn | error | silent
VITE_LOG_LEVEL=info
# Where the code reader reads the lab code from at dev/build time: the esp-labs checkout
# (labs/<lab> projects + kit/), or an older single-project test-esp folder. Relative to this
# folder. Not exposed to the browser.
FIRMWARE_DIR=../esp-labs
# Where the browser fetches the bundled lab code (index.json + one JSON per environment).
VITE_FIRMWARE_URL=./firmware/
# Where the lessons' "View the code on GitHub" links point: the folder holding every lab project.
VITE_LABS_SOURCE_URL=https://github.com/agharsallah/esp-labs/tree/main/labs/
# Espressif's ESP32-S3 reference (Markdown + its images/ folder) for the citation reader, read at
# dev/build time. Espressif's text, kept in the repo for the deploy. When the file is absent, citations stay plain
# citations with a link to Espressif's PDF. Relative to this folder.
REFERENCE_FILE=docs-llm/esp32-s3/ESP32-S3_REFERENCE.md
# Where the browser fetches the reader's documents (index.json, sections/, images/); "" turns it off.
VITE_REFERENCE_URL=./reference/
